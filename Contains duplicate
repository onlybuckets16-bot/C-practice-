#include <stdio.h>
#include <stdbool.h>

int main()
{
    int nums[] = {1, 2, 3, 1};
    int numsSize = 4;

    bool result = false;

    for (int i = 0; i < numsSize; i++) {
        for (int j = i + 1; j < numsSize; j++) {
            if (nums[i] == nums[j]) {
                result = true;
            }
        }
    }

    if (result) {
        printf("true");
    } else {
        printf("false");
    }

    return 0;
}
